NODE_ENV=development
SERVICE_NAME=social-user-service
PORT=3002
HOST=0.0.0.0

DATABASE_URL=postgresql://postgres:replace-with-password@localhost:5433/users_db?schema=public
AUTH_DATABASE_URL=postgresql://postgres:replace-with-password@localhost:54321/auth_db?schema=public
RABBITMQ_URL=amqp://admin:replace-with-password@localhost:5672

REDIS_URL=redis://localhost:6379
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_RECONNECT_BASE_MS=100
REDIS_RECONNECT_MAX_MS=2000

USER_CACHE_TTL_SECONDS=300
USER_LIST_CACHE_TTL_SECONDS=60

USER_EVENTS_EXCHANGE=user.events
USER_REGISTERED_QUEUE=user-service.user.registered
USER_REGISTERED_ROUTING_KEY=user.registered

RABBITMQ_CONNECT_MAX_ATTEMPTS=30
RABBITMQ_CONNECT_RETRY_DELAY_MS=2000
RABBITMQ_CONNECT_MAX_RETRY_DELAY_MS=10000
RABBITMQ_PREFETCH_COUNT=10

PAGINATION_DEFAULT_LIMIT=20
PAGINATION_MAX_LIMIT=50
MAX_AUTHORS_BATCH_SIZE=50
MIN_SEARCH_QUERY_LENGTH=2

BCRYPT_SALT_ROUNDS=10
PASSWORD_CHANGE_PURPOSE=password_change
PASSWORD_CODE_TTL_MINUTES=15
MIN_PASSWORD_LENGTH=8

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=replace-with-smtp-user@gmail.com
SMTP_PASS=replace-with-smtp-app-password
SMTP_FROM=replace-with-smtp-from@gmail.com

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=social-avatars
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_PUBLIC_BASE_URL=http://localhost:9000/social-avatars
S3_UPLOAD_ENDPOINT=http://localhost:9000
S3_UPLOAD_URL_TTL_SECONDS=300
S3_FORCE_PATH_STYLE=true
