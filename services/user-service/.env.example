NODE_ENV=development
SERVICE_NAME=social-user-service
PORT=3002
HOST=0.0.0.0
LOG_LEVEL=info

JWT_SECRET=local-dev-jwt-secret-at-least-32-chars-long
SERVICE_JWT_SECRET=local-dev-service-jwt-secret-different-32chars
JWT_ISSUER=social-auth-service
JWT_AUDIENCE=social-api
JWT_CLOCK_TOLERANCE_SEC=30
JWT_CLAIMS_STRICT=false
INTERNAL_API_AUTH_ENABLED=true

DATABASE_URL=postgresql://postgres:local-dev-postgres-password@localhost:5433/users_db?schema=public
AUTH_DATABASE_URL=postgresql://postgres:local-dev-postgres-password@localhost:5432/auth_db?schema=public
RABBITMQ_URL=amqp://social-rabbit:local-dev-rabbitmq-password@localhost:5672

REDIS_URL=redis://localhost:6379
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_RECONNECT_BASE_MS=100
REDIS_RECONNECT_MAX_MS=2000

USER_CACHE_TTL_SECONDS=300
USER_LIST_CACHE_TTL_SECONDS=60

USER_EVENTS_EXCHANGE=user.events
USER_REGISTERED_QUEUE=user-service.user.registered
USER_REGISTERED_ROUTING_KEY=user.registered

RABBITMQ_CONNECT_MAX_ATTEMPTS=30
RABBITMQ_CONNECT_RETRY_DELAY_MS=2000
RABBITMQ_CONNECT_MAX_RETRY_DELAY_MS=10000
RABBITMQ_PREFETCH_COUNT=10

PAGINATION_DEFAULT_LIMIT=20
PAGINATION_MAX_LIMIT=50
MAX_AUTHORS_BATCH_SIZE=50
MIN_SEARCH_QUERY_LENGTH=2

BCRYPT_SALT_ROUNDS=10
PASSWORD_CHANGE_PURPOSE=password_change
PASSWORD_CODE_TTL_MINUTES=15
MIN_PASSWORD_LENGTH=8

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=replace-with-smtp-user@gmail.com
SMTP_PASS=replace-with-smtp-app-password
SMTP_FROM=replace-with-smtp-from@gmail.com

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=social-avatars
S3_ACCESS_KEY_ID=localminio
S3_SECRET_ACCESS_KEY=local-dev-minio-secret
S3_PUBLIC_BASE_URL=http://localhost:9000/social-avatars
S3_UPLOAD_ENDPOINT=http://localhost:9000
S3_UPLOAD_URL_TTL_SECONDS=300
S3_FORCE_PATH_STYLE=true
