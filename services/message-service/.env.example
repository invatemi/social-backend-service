NODE_ENV=development
SERVICE_NAME=social-message-service
PORT=3004
HOST=0.0.0.0
LOG_LEVEL=info

DATABASE_URL=postgresql://postgres:replace-with-password@localhost:5435/messages_db?schema=public

DB_CONNECT_MAX_ATTEMPTS=10
DB_CONNECT_RETRY_DELAY_MS=2000

JWT_SECRET=replace-with-long-random-secret-at-least-32-chars
