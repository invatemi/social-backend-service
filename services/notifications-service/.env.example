NODE_ENV=development
SERVICE_NAME=social-notifications-service
PORT=3005
HOST=0.0.0.0
LOG_LEVEL=info

DATABASE_URL=postgresql://postgres:local-dev-postgres-password@localhost:5436/notifications_db?schema=public
RABBITMQ_URL=amqp://social-rabbit:local-dev-rabbitmq-password@localhost:5672
JWT_SECRET=local-dev-jwt-secret-at-least-32-chars-long
JWT_ISSUER=social-auth-service
JWT_AUDIENCE=social-api
JWT_CLOCK_TOLERANCE_SEC=30
JWT_CLAIMS_STRICT=false
AUTH_SERVICE_URL=http://localhost:3001
SERVICE_CLIENT_ID=notifications-service
SERVICE_CLIENT_SECRET=local-dev-notifications-service-secret
INTERNAL_API_AUTH_ENABLED=true

USER_SERVICE_URL=http://localhost:3002
USER_SERVICE_TIMEOUT_MS=3000
SOCKET_CORS_ORIGIN=http://localhost:5173
REDIS_URL=redis://localhost:6379

USER_EVENTS_EXCHANGE=user.events
POST_EVENTS_EXCHANGE=post.events

RABBITMQ_CONNECT_MAX_ATTEMPTS=30
RABBITMQ_CONNECT_RETRY_DELAY_MS=2000
RABBITMQ_CONNECT_MAX_RETRY_DELAY_MS=10000
RABBITMQ_PREFETCH_COUNT=10

DB_CONNECT_MAX_ATTEMPTS=10
DB_CONNECT_RETRY_DELAY_MS=2000

QUEUE_COMMENT_CREATED=notifications.comment.created
QUEUE_COMMENT_UPDATED=notifications.comment.updated
QUEUE_COMMENT_DELETED=notifications.comment.deleted
QUEUE_POST_CREATED=notifications.post.created
QUEUE_POST_UPDATED=notifications.post.updated
QUEUE_POST_DELETED=notifications.post.deleted
QUEUE_POST_LIKED=notifications.post.liked
QUEUE_FRIEND_REQUESTED=notifications.user.friend.requested
QUEUE_FRIEND_ACCEPTED=notifications.user.friend.accepted
QUEUE_FRIEND_REMOVED=notifications.user.friend.removed
QUEUE_FRIEND_CANCELLED=notifications.user.friend.cancelled
QUEUE_FRIEND_DECLINED=notifications.user.friend.declined
QUEUE_FOLLOW_CREATED=notifications.user.follow.created
QUEUE_FOLLOW_DELETED=notifications.user.follow.deleted
QUEUE_USER_UPDATED=notifications.user.updated
QUEUE_PHOTO_CREATED=notifications.user.photo.created
QUEUE_PHOTO_DELETED=notifications.user.photo.deleted
MESSAGE_EVENTS_EXCHANGE=message.events
QUEUE_MESSAGE_CREATED=notifications.message.created
QUEUE_MESSAGE_UPDATED=notifications.message.updated
QUEUE_MESSAGE_DELETED=notifications.message.deleted
QUEUE_CHAT_CREATED=notifications.chat.created
QUEUE_CHAT_DELETED=notifications.chat.deleted
QUEUE_CHAT_READ=notifications.chat.read
