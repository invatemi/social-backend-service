// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Notification {
  id              Int       @id @default(autoincrement())
  recipientUserId Int       @map("recipient_user_id")
  actorUserId     Int?      @map("actor_user_id")
  type            String    @db.VarChar(50)
  title           String    @db.VarChar(150)
  body            String
  payload         Json?
  readAt          DateTime? @map("read_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([recipientUserId, createdAt(sort: Desc)], map: "idx_notifications_recipient_created")
  @@index([recipientUserId, readAt], map: "idx_notifications_recipient_read")
  @@map("notifications")
}
