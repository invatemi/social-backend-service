NODE_ENV=development
SERVICE_NAME=social-auth-service
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

DATABASE_URL=postgresql://postgres:local-dev-postgres-password@localhost:5432/auth_db?schema=public
RABBITMQ_URL=amqp://social-rabbit:local-dev-rabbitmq-password@localhost:5672

JWT_SECRET=local-dev-jwt-secret-at-least-32-chars-long
JWT_ISSUER=social-auth-service
JWT_AUDIENCE=social-api
JWT_CLOCK_TOLERANCE_SEC=30
JWT_CLAIMS_STRICT=false
SERVICE_JWT_SECRET=local-dev-service-jwt-secret-different-32chars
SERVICE_JWT_TTL_SEC=300
SERVICE_CLIENT_POST_SERVICE_ID=post-service
SERVICE_CLIENT_POST_SERVICE_SECRET=local-dev-post-service-secret
SERVICE_CLIENT_NOTIFICATIONS_SERVICE_ID=notifications-service
SERVICE_CLIENT_NOTIFICATIONS_SERVICE_SECRET=local-dev-notifications-service-secret
ACCESS_TOKEN_KEY_ID=auth-service-key
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY_DAYS=7
BCRYPT_SALT_ROUNDS=10
DEFAULT_USER_ROLE_ID=3
REFRESH_TOKEN_BYTES=48
REFRESH_TOKEN_PEPPER=local-dev-refresh-token-pepper-at-least-32
MIN_PASSWORD_LENGTH=8
MIN_USERNAME_LENGTH=2

USER_EVENTS_EXCHANGE=user.events
RABBITMQ_CONNECT_MAX_ATTEMPTS=30
RABBITMQ_CONNECT_RETRY_DELAY_MS=2000
RABBITMQ_CONNECT_MAX_RETRY_DELAY_MS=10000

# Rate limiting (in-memory; for cluster use Redis store — see middleware/rate-limit.ts)
TRUST_PROXY_HOPS=1
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MS=60000
RATE_LIMIT_REGISTER_MAX=3
RATE_LIMIT_REGISTER_WINDOW_MS=3600000

# Refresh token HttpOnly cookie
REFRESH_COOKIE_NAME=refreshToken
REFRESH_COOKIE_PATH=/api/auth
REFRESH_COOKIE_SAME_SITE=lax
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_MAX_AGE_DAYS=7
