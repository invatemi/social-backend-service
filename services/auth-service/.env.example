NODE_ENV=development
SERVICE_NAME=social-auth-service
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

DATABASE_URL=postgresql://postgres:replace-with-password@localhost:5432/auth_db?schema=public
RABBITMQ_URL=amqp://replace-with-rabbitmq-user:replace-with-rabbitmq-password@localhost:5672

JWT_SECRET=replace-with-long-random-secret-at-least-32-chars
ACCESS_TOKEN_KEY_ID=auth-service-key
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY_DAYS=7
BCRYPT_SALT_ROUNDS=10
DEFAULT_USER_ROLE_ID=3
REFRESH_TOKEN_BYTES=48
MIN_PASSWORD_LENGTH=8
MIN_USERNAME_LENGTH=2

USER_EVENTS_EXCHANGE=user.events
RABBITMQ_CONNECT_MAX_ATTEMPTS=30
RABBITMQ_CONNECT_RETRY_DELAY_MS=2000
RABBITMQ_CONNECT_MAX_RETRY_DELAY_MS=10000
