NODE_ENV=development
SERVICE_NAME=social-post-service
PORT=3003
HOST=0.0.0.0

DATABASE_URL=postgresql://postgres:replace-with-password@localhost:5434/posts_db?schema=public
RABBITMQ_URL=amqp://admin:replace-with-password@localhost:5672

REDIS_URL=redis://localhost:6379
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_RECONNECT_BASE_MS=100
REDIS_RECONNECT_MAX_MS=2000

POST_CACHE_TTL_SECONDS=300
POST_LIST_CACHE_TTL_SECONDS=60

USER_SERVICE_URL=http://localhost:3002
USER_SERVICE_TIMEOUT_MS=3000

POST_EVENTS_EXCHANGE=post.events
DEFAULT_PAGE=1
DEFAULT_PAGE_SIZE=10

RABBITMQ_CONNECT_MAX_ATTEMPTS=30
RABBITMQ_CONNECT_RETRY_DELAY_MS=2000
RABBITMQ_CONNECT_MAX_RETRY_DELAY_MS=10000
