NODE_ENV=development
SERVICE_NAME=social-post-service
PORT=3003
HOST=0.0.0.0
LOG_LEVEL=info

JWT_SECRET=local-dev-jwt-secret-at-least-32-chars-long
JWT_ISSUER=social-auth-service
JWT_AUDIENCE=social-api
JWT_CLOCK_TOLERANCE_SEC=30
JWT_CLAIMS_STRICT=false
AUTH_SERVICE_URL=http://localhost:3001
SERVICE_CLIENT_ID=post-service
SERVICE_CLIENT_SECRET=local-dev-post-service-secret
INTERNAL_API_AUTH_ENABLED=true

DATABASE_URL=postgresql://postgres:local-dev-postgres-password@localhost:5434/posts_db?schema=public
RABBITMQ_URL=amqp://social-rabbit:local-dev-rabbitmq-password@localhost:5672

REDIS_URL=redis://localhost:6379
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_RECONNECT_BASE_MS=100
REDIS_RECONNECT_MAX_MS=2000

POST_CACHE_TTL_SECONDS=300
POST_LIST_CACHE_TTL_SECONDS=60

USER_SERVICE_URL=http://localhost:3002
USER_SERVICE_TIMEOUT_MS=3000

POST_EVENTS_EXCHANGE=post.events
DEFAULT_PAGE=1
DEFAULT_PAGE_SIZE=10

RABBITMQ_CONNECT_MAX_ATTEMPTS=30
RABBITMQ_CONNECT_RETRY_DELAY_MS=2000
RABBITMQ_CONNECT_MAX_RETRY_DELAY_MS=10000

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=social-avatars
S3_ACCESS_KEY_ID=localminio
S3_SECRET_ACCESS_KEY=local-dev-minio-secret
S3_PUBLIC_BASE_URL=http://localhost:9000/social-avatars
S3_UPLOAD_ENDPOINT=http://localhost:9000
S3_UPLOAD_URL_TTL_SECONDS=300
S3_FORCE_PATH_STYLE=true
