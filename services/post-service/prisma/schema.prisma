generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model comments {
  id_comment Int      @id @default(autoincrement())
  id_post    Int
  id_user    Int
  content    String
  created_at DateTime @default(now())
  posts      posts    @relation(fields: [id_post], references: [id_post], onDelete: Cascade)

  @@index([id_post], map: "idx_comments_post")
}

model likes {
  id_like    Int      @id @default(autoincrement())
  id_post    Int
  id_user    Int
  created_at DateTime @default(now())
  posts      posts    @relation(fields: [id_post], references: [id_post], onDelete: Cascade)

  @@unique([id_post, id_user], map: "uq_like_post_user")
  @@index([id_post, id_user], map: "idx_likes_post_user")
}

model posts {
  id_post        Int        @id @default(autoincrement())
  id_user        Int
  title          String?    @db.VarChar(150)
  content        String
  image_url      String?
  is_published   Boolean    @default(true)
  likes_count    Int        @default(0)
  comments_count Int        @default(0)
  created_at     DateTime   @default(now())
  updated_at     DateTime   @default(now())
  comments       comments[]
  likes          likes[]

  @@index([created_at(sort: Desc)], map: "idx_posts_created")
  @@index([is_published], map: "idx_posts_published")
  @@index([id_user], map: "idx_posts_user")
}
