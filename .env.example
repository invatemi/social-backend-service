# =============================================================================
# Social Backend Service — корневой конфиг для Docker Compose
# =============================================================================
# Скопируйте этот файл:  cp .env.example .env   (или scripts/setup-env.ps1)
# Затем замените все значения replace-with-* на свои секреты.
# Файл .env не коммитится в git — храните секреты только локально.
# =============================================================================

# --- Сеть и безопасность ---
# 127.0.0.1 — порты доступны только с localhost (рекомендуется для dev)
# 0.0.0.0    — порты доступны извне (только для prod за reverse-proxy/firewall)
BIND_ADDRESS=127.0.0.1

# Разрешённые origins для CORS (через запятую, без пробелов)
# KrakenD API Gateway и WebSocket уведомлений используют этот список
CORS_ORIGINS=http://localhost:5173

# --- API Gateway (KrakenD) ---
KRAKEND_PORT=8080
KRAKEND_EXTERNAL_PORT=8080
KRAKEND_FC_ENABLE=1
KRAKEND_LOG_LEVEL=INFO

# --- Базы данных (PostgreSQL) ---
AUTH_DB_NAME=auth_db
USER_DB_NAME=users_db
POST_DB_NAME=posts_db
MSG_DB_NAME=messages_db
NOTIF_DB_NAME=notifications_db

AUTH_DB_HOST=auth-db
USER_DB_HOST=user-db
POST_DB_HOST=post-db
MSG_DB_HOST=msg-db
NOTIF_DB_HOST=notif-db

DB_USER=postgres
DB_PASSWORD=replace-with-strong-password

# Внешние порты БД (только при локальной разработке вне Docker)
AUTH_DB_EXTERNAL_PORT=5432
USER_DB_EXTERNAL_PORT=5433
POST_DB_EXTERNAL_PORT=5434
MSG_DB_EXTERNAL_PORT=5435
NOTIF_DB_EXTERNAL_PORT=5436

# --- JWT (user access tokens) ---
JWT_SECRET=replace-with-long-random-secret-at-least-32-chars
JWT_ISSUER=social-auth-service
JWT_AUDIENCE=social-api
JWT_CLOCK_TOLERANCE_SEC=30
JWT_CLAIMS_STRICT=false

# --- Service-to-service JWT (отдельный секрет, не публикуется в JWKS) ---
SERVICE_JWT_SECRET=replace-with-different-long-random-secret-at-least-32-chars
SERVICE_JWT_TTL_SEC=300

REFRESH_TOKEN_PEPPER=replace-with-long-random-pepper-at-least-32-chars

# --- Service-to-service auth (Client Credentials) ---
# Используется post-service и notifications-service для /api/users/internal/*
AUTH_SERVICE_URL=http://social-auth-service:3001
INTERNAL_API_AUTH_ENABLED=true
SERVICE_CLIENT_POST_SERVICE_ID=post-service
SERVICE_CLIENT_POST_SERVICE_SECRET=replace-with-random-post-service-secret
SERVICE_CLIENT_NOTIFICATIONS_SERVICE_ID=notifications-service
SERVICE_CLIENT_NOTIFICATIONS_SERVICE_SECRET=replace-with-random-notifications-service-secret

# --- Docker networks ---
# edge-net: KrakenD, MinIO, notifications WebSocket (временные внешние порты)
# backend-net (internal:true): микросервисы, БД, Redis, RabbitMQ — без host ports

# --- Микросервисы (внутренние порты) ---
AUTH_PORT=3001
# Auth rate limiting (auth-service .env)
TRUST_PROXY_HOPS=1
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MS=60000
RATE_LIMIT_REGISTER_MAX=3
RATE_LIMIT_REGISTER_WINDOW_MS=3600000
USER_PORT=3002
POST_PORT=3003
MSG_PORT=3004
NOTIF_PORT=3005
NOTIF_EXTERNAL_PORT=3005

# Внешние порты микросервисов (только для локальной разработки вне Docker)
AUTH_EXTERNAL_PORT=3001
USER_EXTERNAL_PORT=3002
POST_EXTERNAL_PORT=3003
MSG_EXTERNAL_PORT=3004
NOTIF_EXTERNAL_PORT=3005

# URL user-service для межсервисных вызовов (Docker internal DNS)
USER_SERVICE_URL=http://social-user-service:3002
USER_SERVICE_TIMEOUT_MS=3000

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=replace-with-rabbitmq-user
RABBITMQ_DEFAULT_PASS=replace-with-rabbitmq-password
RABBITMQ_DEFAULT_VHOST=/
RABBITMQ_AMQP_EXTERNAL_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_MANAGEMENT_EXTERNAL_PORT=15672
RABBITMQ_MANAGEMENT_IP=127.0.0.1
RABBITMQ_DEFINITIONS_FILE=/etc/rabbitmq/definitions.json
RABBITMQ_LOG_LEVEL=info
RABBITMQ_MEMORY_HIGH_WATERMARK=0.6
RABBITMQ_DISK_FREE_LIMIT=2GB

# --- Redis ---
REDIS_URL=redis://redis:6379
REDIS_EXTERNAL_PORT=6379
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_MAXMEMORY=256mb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# --- Кэширование ---
POST_CACHE_TTL_SECONDS=300
POST_LIST_CACHE_TTL_SECONDS=60
USER_CACHE_TTL_SECONDS=300
USER_LIST_CACHE_TTL_SECONDS=60

# --- MinIO / S3 (хранение аватаров) ---
MINIO_API_EXTERNAL_PORT=9000
MINIO_CONSOLE_EXTERNAL_PORT=9001
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=social-avatars
S3_ACCESS_KEY_ID=replace-with-s3-access-key
S3_SECRET_ACCESS_KEY=replace-with-s3-secret-key
S3_PUBLIC_BASE_URL=http://localhost:9000/social-avatars
S3_UPLOAD_ENDPOINT=http://localhost:9000
S3_UPLOAD_URL_TTL_SECONDS=300
S3_FORCE_PATH_STYLE=true

# --- SMTP (смена пароля через email) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=replace-with-smtp-user@gmail.com
SMTP_PASS=replace-with-smtp-app-password
SMTP_FROM=replace-with-smtp-from@gmail.com
PASSWORD_CODE_TTL_MINUTES=15

# --- Логирование ---
LOG_LEVEL=info

# --- Elastic Stack (опционально, профиль observability) ---
# docker compose --profile observability up
ELASTICSEARCH_EXTERNAL_PORT=9200
KIBANA_EXTERNAL_PORT=5601
ES_JAVA_OPTS=-Xms512m -Xmx512m
