KRAKEND_PORT=8080
KRAKEND_EXTERNAL_PORT=8080
KRAKEND_FC_ENABLE=1
KRAKEND_LOG_LEVEL=INFO

AUTH_DB_NAME=auth_db
USER_DB_NAME=users_db
POST_DB_NAME=posts_db
MSG_DB_NAME=messages_db
NOTIF_DB_NAME=notifications_db

AUTH_DB_HOST=auth-db
USER_DB_HOST=user-db
POST_DB_HOST=post-db
MSG_DB_HOST=msg-db
NOTIF_DB_HOST=notif-db

DB_USER=postgres
DB_PASSWORD=replace-with-strong-password
JWT_SECRET=replace-with-long-random-secret

AUTH_PORT=3001
USER_PORT=3002
POST_PORT=3003
MSG_PORT=3004
NOTIF_PORT=3005

AUTH_EXTERNAL_PORT=3001
USER_EXTERNAL_PORT=3002
POST_EXTERNAL_PORT=3003
MSG_EXTERNAL_PORT=3004
NOTIF_EXTERNAL_PORT=3005

AUTH_DB_EXTERNAL_PORT=5432
USER_DB_EXTERNAL_PORT=5433
POST_DB_EXTERNAL_PORT=5434
MSG_DB_EXTERNAL_PORT=5435
NOTIF_DB_EXTERNAL_PORT=5436

RABBITMQ_DEFAULT_USER=replace-with-rabbitmq-user
RABBITMQ_DEFAULT_PASS=replace-with-rabbitmq-password
RABBITMQ_DEFAULT_VHOST=/
RABBITMQ_AMQP_EXTERNAL_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_MANAGEMENT_EXTERNAL_PORT=15672
RABBITMQ_MANAGEMENT_IP=127.0.0.1
RABBITMQ_DEFINITIONS_FILE=/etc/rabbitmq/definitions.json
RABBITMQ_LOG_LEVEL=info
RABBITMQ_VM_MEMORY_HIGH_WATERMARK=0.6
RABBITMQ_DISK_FREE_LIMIT=2GB

REDIS_URL=redis://redis:6379
REDIS_EXTERNAL_PORT=6379
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_MAXMEMORY=256mb
REDIS_MAXMEMORY_POLICY=allkeys-lru

POST_CACHE_TTL_SECONDS=300
POST_LIST_CACHE_TTL_SECONDS=60
USER_CACHE_TTL_SECONDS=300
USER_LIST_CACHE_TTL_SECONDS=60
