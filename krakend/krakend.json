{
  "version": 3,
  "name": "Social Backend Gateway",
  "port": 8080,
  "timeout": "10000ms",
  "endpoints": [
    {
      "endpoint": "/api/auth/health",
      "method": "GET",
      "public": true,
      "backend": [{
        "host": ["http://social-auth-service:3001"],
        "url_pattern": "/health"
      }]
    },
    {
      "endpoint": "/api/auth/register",
      "method": "POST",
      "public": true,
      "input_headers": ["*"],
      "backend": [{
        "host": ["http://social-auth-service:3001"],
        "url_pattern": "/api/auth/register"
        
      }]
    },
    {
      "endpoint": "/api/auth/login",
      "method": "POST",
      "public": true,
      "input_headers": ["*"],
      "backend": [{
        "host": ["http://social-auth-service:3001"],
        "url_pattern": "/api/auth/login"
        
      }]
    },
    {
      "endpoint": "/api/auth/refresh",
      "method": "POST",
      "public": true,
      "input_headers": ["*"],
      "backend": [{
        "host": ["http://social-auth-service:3001"],
        "url_pattern": "/api/auth/refresh"
        
      }]
    },
    {
      "endpoint": "/api/auth/logout",
      "method": "POST",
      "public": true,
      "input_headers": ["*"],
      "backend": [{
        "host": ["http://social-auth-service:3001"],
        "url_pattern": "/api/auth/logout"
        
      }]
    },
    {
      "endpoint": "/api/users/health",
      "method": "GET",
      "public": true,
      "backend": [{
        "host": ["http://social-user-service:3002"],
        "url_pattern": "/health"
      }]
    },
    {
      "endpoint": "/api/users/me/followers",
      "method": "GET",
      "input_headers": ["Authorization", "Content-Type"],
      "backend": [{
        "host": ["http://social-user-service:3002"],
        "url_pattern": "/api/followers/me/followers"
      }]
    },
    {
      "endpoint": "/api/users/me/following",
      "method": "GET",
      "input_headers": ["Authorization", "Content-Type"],
      "backend": [{
        "host": ["http://social-user-service:3002"],
        "url_pattern": "/api/followers/me/following"
      }]
    },
    {
      "endpoint": "/api/users/me/is-following/{id}",
      "method": "GET",
      "input_headers": ["Authorization", "Content-Type"],
      "backend": [{
        "host": ["http://social-user-service:3002"],
        "url_pattern": "/api/followers/me/is-following/{id}"
      }]
    },
    {
      "endpoint": "/api/users/{id}/followers",
      "method": "GET",
      "public": true,
      "backend": [{
        "host": ["http://social-user-service:3002"],
        "url_pattern": "/api/followers/{id}/followers"
      }]
    },
    {
      "endpoint": "/api/users/{id}/following",
      "method": "GET",
      "public": true,
      "backend": [{
        "host": ["http://social-user-service:3002"],
        "url_pattern": "/api/followers/{id}/following"
      }]
    },
    {
      "endpoint": "/api/users/{id}/counts",
      "method": "GET",
      "public": true,
      "backend": [{
        "host": ["http://social-user-service:3002"],
        "url_pattern": "/api/followers/{id}/counts"
      }]
    },
    {
      "endpoint": "/api/users/{id}/follow",
      "method": "POST",
      "input_headers": ["Authorization", "Content-Type"],
      "backend": [{
        "host": ["http://social-user-service:3002"],
        "url_pattern": "/api/followers/{id}/follow"
      }]
    },
    {
      "endpoint": "/api/users/{id}/follow",
      "method": "DELETE",
      "input_headers": ["Authorization", "Content-Type"],
      "backend": [{
        "host": ["http://social-user-service:3002"],
        "url_pattern": "/api/followers/{id}/follow"
      }]
    },
    {
      "endpoint": "/api/users/me/friends",
      "method": "GET",
      "input_headers": ["Authorization", "Content-Type"],
      "backend": [{
        "host": ["http://social-user-service:3002"],
        "url_pattern": "/api/friends/me"
      }]
    },
    {
      "endpoint": "/api/users/me/friends/{id}",
      "method": "DELETE",
      "input_headers": ["Authorization", "Content-Type"],
      "backend": [{
        "host": ["http://social-user-service:3002"],
        "url_pattern": "/api/friends/{id}"
      }]
    },
    {
      "endpoint": "/api/users/me/is-friends/{id}",
      "method": "GET",
      "input_headers": ["Authorization", "Content-Type"],
      "backend": [{
        "host": ["http://social-user-service:3002"],
        "url_pattern": "/api/friends/me/is-friends/{id}"
      }]
    },
    {
      "endpoint": "/api/users/{id}/friends",
      "method": "GET",
      "public": true,
      "backend": [{
        "host": ["http://social-user-service:3002"],
        "url_pattern": "/api/friends/{id}"
      }]
    },
    {
      "endpoint": "/api/users/{id}/friends/count",
      "method": "GET",
      "public": true,
      "backend": [{
        "host": ["http://social-user-service:3002"],
        "url_pattern": "/api/friends/{id}/count"
      }]
    },
    {
      "endpoint": "/api/posts/health",
      "method": "GET",
      "public": true,
      "backend": [{
        "host": ["http://social-post-service:3003"],
        "url_pattern": "/health"
      }]
    },
    {
      "endpoint": "/api/messages/health",
      "method": "GET",
      "public": true,
      "backend": [{
        "host": ["http://social-message-service:3004"],
        "url_pattern": "/health"
      }]
    },
    {
      "endpoint": "/api/notifications/health",
      "method": "GET",
      "public": true,
      "backend": [{
        "host": ["http://social-notifications-service:3005"],
        "url_pattern": "/health"
      }]
    }
  ],
  "extra_config": {
    "auth/validator": {
      "alg": "HS256",
      "key": "${JWT_SECRET}",
      "roles_key": "role",

      "propagate_claims": [
        ["userId", "X-User-Id"],
        ["role", "X-User-Role"]
      ],

      "roles": {
        "/api/auth/": ["admin", "moderator", "user", "guest"],
        "/api/users/": ["admin", "moderator", "user"],
        "/api/posts/": ["admin", "moderator", "user"],
        "/api/messages/": ["admin", "moderator", "user"],
        "/api/notifications/": ["admin", "moderator", "user"]
      }
    }
  }
}