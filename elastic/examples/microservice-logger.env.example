# Recommended logger settings for microservices (Pino / structured JSON to stdout).
# Add these variables to each service .env or docker-compose environment block.

LOG_LEVEL=info
# LOG_LEVEL=debug   # enable verbose debug logs in dev

# Pino outputs JSON to stdout by default in production (NODE_ENV=production).
# Example bootstrap (TypeScript):
#
# import pino from 'pino';
# export const logger = pino({
#   level: process.env.LOG_LEVEL ?? 'info',
#   base: { service: process.env.SERVICE_NAME },
# });
#
# logger.info({ port }, 'Service started');
# logger.debug({ routingKey }, 'Event published');
# logger.warn({ attempt }, 'Reconnecting to RabbitMQ');
# logger.error({ err }, 'Handler failed');
